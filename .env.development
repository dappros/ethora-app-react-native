# QA servers — local runs and debug builds (NODE_ENV=development)
EXPO_PUBLIC_API=https://api.chat-qa.ethora.com/v1
EXPO_PUBLIC_API_V2=https://api.chat-qa.ethora.com/v2
# "Join our Open Workspace": the open workspace address (domainName.cluster)
EXPO_PUBLIC_OPEN_WORKSPACE=app.chat-qa.ethora.com
# Addresses typed on the workspace screen that also open it, comma separated
EXPO_PUBLIC_OPEN_WORKSPACE_ALIASES=app.chat.ethora.com

EXPO_PUBLIC_APP_XMPP_SERVICE=xmpp.chat-qa.ethora.com
EXPO_PUBLIC_XMPP_SERVICE=conference.xmpp.chat-qa.ethora.com
EXPO_PUBLIC_XMPP_HOST=xmpp.chat-qa.ethora.com

EXPO_PUBLIC_LIVEKIT_URL=https://livekit.ethora-qa.com

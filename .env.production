# Production servers — release bundles for Google Play / App Store (NODE_ENV=production)
EXPO_PUBLIC_API=https://api.chat.ethora.com/v1
EXPO_PUBLIC_API_V2=https://api.chat.ethora.com/v2
# "Join our Open Workspace": the open workspace address (domainName.cluster)
EXPO_PUBLIC_OPEN_WORKSPACE=app.chat.ethora.com
# Addresses typed on the workspace screen that also open it, comma separated
EXPO_PUBLIC_OPEN_WORKSPACE_ALIASES=

EXPO_PUBLIC_APP_XMPP_SERVICE=xmpp.chat.ethora.com
EXPO_PUBLIC_XMPP_SERVICE=conference.xmpp.chat.ethora.com
EXPO_PUBLIC_XMPP_HOST=xmpp.chat.ethora.com

# Production LiveKit server (calls are off in .env for now)
EXPO_PUBLIC_LIVEKIT_URL=

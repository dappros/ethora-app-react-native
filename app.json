{
  "expo": {
    "name": "ethora-app",
    "slug": "ethora-app",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-video",
      "expo-font",
      "expo-router",
      "expo-status-bar",
      "expo-asset",
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      ["expo-notifications", { "defaultChannel": "messages" }]
    ],
    "scheme": "ethoraappreactnative",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ethora.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.ethora",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "push": {
        "buildOrigin": "platform"
      },
      "eas": {
        "projectId": "b79aedc2-ad0f-40ed-b8bd-4b54010d9f0f"
      }
    }
  }
}

{
  "expo": {
    "name": "Ethora",
    "slug": "ethora-app",
    "version": "1.0.5",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-video",
      "expo-font",
      "expo-router",
      "expo-status-bar",
      "expo-asset",
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0F1216"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "icon": "./assets/notification-icon.png",
          "color": "#0052CD"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.972933470054-ca7eragog9vsiq0kbl7i06ovupakr941"
        }
      ]
    ],
    "scheme": "ethoraappreactnative",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ethora.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7740CA"
      },
      "package": "com.ethora",
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "push": {
        "buildOrigin": "platform"
      },
      "eas": {
        "projectId": "b79aedc2-ad0f-40ed-b8bd-4b54010d9f0f"
      }
    }
  }
}

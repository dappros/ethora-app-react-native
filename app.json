{
  "expo": {
    "name": "Ethora",
    "slug": "ethora-app",
    "version": "1.0.9",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-video",
      "expo-font",
      "expo-router",
      "expo-status-bar",
      "expo-asset",
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0F1216"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "icon": "./assets/notification-icon.png",
          "color": "#0052CD"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.972933470054-ca7eragog9vsiq0kbl7i06ovupakr941"
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@ethora/chat-component-rn",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "$(PRODUCT_NAME) needs access to your camera so you can be seen during video calls and take photos for chats.",
          "microphonePermission": "$(PRODUCT_NAME) needs access to your microphone for audio and video calls and voice messages."
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "scheme": "ethoraappreactnative",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "com.ethora.app",
      "appleTeamId": "822G3N7CA5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7740CA"
      },
      "package": "com.ethora.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "extra": {
      "push": {
        "buildOrigin": "platform",
        "encrypted": true
      },
      "eas": {
        "projectId": "b79aedc2-ad0f-40ed-b8bd-4b54010d9f0f"
      }
    }
  }
}

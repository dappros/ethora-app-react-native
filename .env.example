# Google OAuth clients of the same Firebase project (console → Authentication → Sign-in method → Google).
# Web client: google-services.json → oauth_client with client_type 3.
# iOS client: created for bundle id com.ethora.app; its reversed id goes to app.json → iosUrlScheme.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=972933470054-hbsf29ohpato76til2jtf6jgg1b4374c.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

VITE_DEV_API_TARGET=https://api.chat.ethora.com
# Use native RN fetch instead of expo/fetch (SDK 56+): @ethora/chat-component-rn uploads media
# via fetch+FormData with {uri,name,type} parts, which expo/fetch does not support.
EXPO_PUBLIC_USE_RN_FETCH=1

{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@screens/*": ["./src/screens/*"],
      "@stores/*": ["./src/stores/*"],
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@constants/*": ["./src/constants/*"],
      "@xmpp/*": ["./src/xmpp/*"],
    }
  },
  "files": ["src/declarations.d.ts"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src",
    "src/declarations.d.ts"
  ]
}
